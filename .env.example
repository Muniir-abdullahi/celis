# Database
DATABASE_URL=postgresql://postgres.<project_ref>:<password>@<pooler_host>:6543/postgres
DIRECT_URL=postgresql://postgres:<password>@<db_host>:5432/postgres
DATABASE_POOL_SIZE=10

# Supabase
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=listing-images

# App
APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase Send SMS hook -> Celis -> WAHA. Server-only; never NEXT_PUBLIC_.
SEND_SMS_HOOK_SECRET=
WAHA_BASE_URL=https://waha.rukun.com.so
WAHA_API_KEY=
# Must match the live session exactly (the existing session is spelled defualt).
WAHA_SESSION=defualt
# Generate separate random secrets, at least 32 characters each.
OTP_DELIVERY_ENCRYPTION_KEY=
AUTH_DELIVERY_CRON_SECRET=
# Match Supabase's phone OTP expiration. Do not deliver an already expired code.
OTP_DELIVERY_TTL_SECONDS=300

# Encrypts payment-provider credentials stored in Postgres.
# Generate a long random value and keep it identical across deployed server instances.
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=

# Firebase Cloud Messaging (FCM)
# Set to the JSON string of your Firebase service account key, or a file path to the JSON.
# Required for push notifications. Never commit the actual key.
FIREBASE_SERVICE_ACCOUNT=

# Client (Next.js public prefix; anon key is safe for browser use with RLS)
NEXT_PUBLIC_SUPABASE_URL=https://<project_ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
